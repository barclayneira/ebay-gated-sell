# Copy to ebay.env and chmod 600. Never commit the copy.
# This process is the only one that should hold these values.

# From https://developer.ebay.com/my/keys — production keyset, not sandbox.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# User refresh token from the authorization-code grant.
# Scopes on that token must include sell.inventory and sell.account.
# Application tokens cannot publish. Do not put this value in chat.
EBAY_REFRESH_TOKEN=

EBAY_API_ENV=production
EBAY_MARKETPLACE_ID=EBAY_US

# Where pending cards and approvals are stored. Not a secret, but local.
EBAY_GATE_DIR=./data
